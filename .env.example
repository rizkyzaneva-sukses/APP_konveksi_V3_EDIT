# =============================================================================
# Environment Variables — Stitchlyx Syncore V3
# Copy file ini ke .env.local (development) atau set di Easypanel (production)
# =============================================================================

# PostgreSQL Connection String
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/stitchlyx

# JWT Secret untuk session management (gunakan random string 32+ karakter)
# Generate: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this

# Node environment
NODE_ENV=production
